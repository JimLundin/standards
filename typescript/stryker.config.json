{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"testRunner": "tap",
	"tap": {
		"nodeArgs": [
			"--test-reporter=tap",
			"--test-skip-pattern=@slow",
			"--import",
			"./profiles/mutation.ts",
			"-r",
			"{{hookFile}}",
			"{{testFile}}"
		]
	},
	"mutate": ["src/**/*.ts", "!src/**/*.test.ts"],
	"tsconfigFile": "",
	"incremental": true,
	"thresholds": {
		"high": 100,
		"low": 100,
		"break": 100
	},
	"reporters": ["clear-text"]
}
