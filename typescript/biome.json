{
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"formatter": { "indentStyle": "tab", "lineWidth": 120 },
	"javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noExcessiveCognitiveComplexity": { "level": "warn", "options": { "maxAllowedComplexity": 20 } }
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "warn",
				"noUnusedFunctionParameters": "warn"
			},
			"style": {
				"useConst": "error",
				"noParameterAssign": "warn"
			},
			"suspicious": {
				"noConsole": { "level": "warn", "options": { "allow": ["error", "warn"] } }
			}
		}
	},
	"assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
