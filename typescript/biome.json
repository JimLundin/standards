{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"plugins": [
		"./biome-plugins/noModuleState.grit",
		"./biome-plugins/noNondeterminism.grit",
		"./biome-plugins/useReadonlyMembers.grit",
		"./biome-plugins/useReadonlyTypes.grit"
	],
	"linter": {
		"rules": {
			"preset": "all",
			"nursery": "warn",
			"style": {
				"noRestrictedGlobals": {
					"level": "error",
					"options": {
						"deniedGlobals": {
							"process": "ambient input and side effects: pass values in from the boundary",
							"fetch": "side effect: keep I/O at the boundary",
							"setTimeout": "side effect: keep I/O at the boundary",
							"setInterval": "side effect: keep I/O at the boundary",
							"setImmediate": "side effect: keep I/O at the boundary",
							"queueMicrotask": "side effect: keep I/O at the boundary"
						}
					}
				},
				"useConsistentTestIt": {
					"level": "error",
					"options": {
						"function": "test",
						"withinDescribe": "test"
					}
				}
			},
			"correctness": {
				"noNodejsModules": "off",
				"noProcessGlobal": "off"
			}
		},
		"domains": {
			"astro": "none",
			"drizzle": "none",
			"next": "none",
			"playwright": "none",
			"qwik": "none",
			"react": "none",
			"reactNative": "none",
			"solid": "none",
			"svelte": "none",
			"tailwind": "none",
			"tanstackQuery": "none",
			"turborepo": "none",
			"vue": "none"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts", "**/test/**"],
			"linter": {
				"rules": {
					"style": {
						"noMagicNumbers": "off"
					},
					"suspicious": {
						"useExpect": "off"
					}
				}
			}
		},
		{
			"includes": ["**/package.json"],
			"linter": {
				"rules": {
					"nursery": {
						"usePackageJsonCpu": "off"
					}
				}
			}
		}
	]
}
