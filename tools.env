# The versions of the tools the checks run, one NAME=version per line, read
# by check.sh and by CI (e.g. `grep -v '^#' tools.env >> "$GITHUB_ENV"`).
# A unit's key holds the versions of the tools it runs, so a pass recorded on
# one machine is reused on another only when they match. The Rust toolchain
# is the project's rust-toolchain.toml. RUST_DECISIONS is the version of this
# repository's rust/measure, which a change to it bumps. A suite's `tools`
# name the pins here that its key holds, such as PYTHON, the Python that CI
# installs for a project's scripts.
UV=0.13.8
PYTHON=3.15.2
NODE=26.13.1
NEXTEST=0.9.152
RUST_DECISIONS=0.2.0
SCCACHE=0.19.0
DX=0.7.10
CARGO_MUTANTS=27.1.0
CARGO_MACHETE=0.9.2
SCC=4.1.0
RUFF=0.17.6
BASEDPYRIGHT=1.40.2
VULTURE=2.16
IMPORT_LINTER=2.15
OXLINT=1.95.0
OXFMT=0.80.0
OXLINT_TSGOLINT=7.0.2008
CLOUDFLARE_OXLINT_CONFIG=0.2.0
TYPESCRIPT=7.0.2
EFFECT_TSGO=0.73.4
KNIP=6.48.0
STRYKER=10.1.1
VITEST=5.1.1
EFFECT=4.1.5
JSCPD=5.4.3
