# Standard editor settings. Copy to a project root (EditorConfig does not
# follow references; it only walks up from the file being edited).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyw,pyi,rs,toml}]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,html}]
indent_style = tab
indent_size = 4

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
