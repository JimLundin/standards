root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.{py,pyw,pyi,rs,toml}]
indent_style = space
indent_size = 4

# oxfmt's defaults, which it reads from here unless its config sets them.
[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,html}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
